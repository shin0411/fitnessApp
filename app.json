{
  "expo": {
    "name": "FitnessRPG",
    "slug": "fitnessrpg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fitnessrpg",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shin0411.fitnessrpg",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "FitnessRPGはAI分析と食事記録のためにカメラへのアクセスを使用します。",
        "NSPhotoLibraryUsageDescription": "FitnessRPGはAI分析のために写真へのアクセスを使用します。",
        "NSPhotoLibraryAddUsageDescription": "FitnessRPGはシェアカードを写真ライブラリに保存するために使用します。",
        "NSLocationWhenInUseUsageDescription": "FitnessRPGはランニング・ウォーキングのGPS追跡のために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FitnessRPGはバックグラウンドでのGPS追跡のために位置情報を使用します。",
        "NSMotionUsageDescription": "FitnessRPGは歩数カウントのために動作センサーを使用します。"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.shin0411.fitnessrpg",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A1A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitnessRPGはランニング・ウォーキングのGPS追跡のために位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": "FitnessRPGはバックグラウンドでのGPS追跡のために位置情報を使用します。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitnessRPGはAI分析と食事記録のためにカメラへのアクセスを使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitnessRPGはAI分析・シェアカード保存のために写真へのアクセスを使用します。"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00FFCC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
