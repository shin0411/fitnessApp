{
  "expo": {
    "name": "FitnessRPG",
    "slug": "fitnessrpg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fitnessrpg",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shin0411.fitnessrpg"
    },
    "android": {
      "package": "com.shin0411.fitnessrpg",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A1A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitnessRPG to access your camera for AI analysis and meal logging."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitnessRPG to access your photos for AI analysis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00FFCC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
